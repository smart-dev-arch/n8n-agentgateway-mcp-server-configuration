{
  "name": "MCP Server Demo via agentgateway",
  "nodes": [
    {
      "parameters": {},
      "id": "start-node",
      "name": "When clicking \"Test workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://agentgateway.kgateway-system.svc.cluster.local",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "https://example.com"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request-node",
      "name": "Call MCP Server via agentgateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process the response from MCP Server\nconst response = $input.item.json;\n\nreturn {\n  json: {\n    success: true,\n    timestamp: new Date().toISOString(),\n    mcpResponse: response,\n    message: \"Successfully called MCP Server through agentgateway\"\n  }\n};"
      },
      "id": "process-response-node",
      "name": "Process Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    }
  ],
  "connections": {
    "When clicking \"Test workflow\"": {
      "main": [
        [
          {
            "node": "Call MCP Server via agentgateway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call MCP Server via agentgateway": {
      "main": [
        [
          {
            "node": "Process Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
